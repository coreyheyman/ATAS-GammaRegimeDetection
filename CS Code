        #region Fields

        private DateTime _lastCalculationTime = DateTime.MinValue;
        private RenderFont _font = new("Arial", 12, FontStyle.Bold);
        private RenderFont _levelFont = new("Arial", 10, FontStyle.Bold);
        private decimal _lastNetGex = 0m;
        private bool _isPositiveGamma = true;
        private string _chipText = "Loading GEX...";

        // Key Levels & Metrics Tracked
        private decimal _callWallPrice = 0m;
        private string _callWallMetric = "";
        private decimal _putWallPrice = 0m;
        private string _putWallMetric = "";
        private decimal _flipLevelPrice = 0m;
        private string _flipMetric = "FLIP";

