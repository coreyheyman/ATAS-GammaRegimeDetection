        public GammaChipIndicator() : base(true)
        {
            DenyToChangePanel = true;
            EnableCustomDrawing = true;
            SubscribeToDrawingEvents(DrawingLayouts.LatestBar | DrawingLayouts.Final);

            DataSeries[0].IsHidden = true;
            ((ValueDataSeries)DataSeries[0]).VisualType = VisualMode.Hide;
        }

        protected override void OnCalculate(int bar, decimal value)
        {
            if (bar < CurrentBar - 1) return;

            if (Frequency != UpdateFrequency.Live && _chipText != "Loading GEX...")
            {
                var now = DateTime.Now;
                bool shouldUpdate = Frequency switch
                {
                    UpdateFrequency.ThirtySeconds => now.Second == 0 || now.Second == 30,
                    UpdateFrequency.OneMinute => now.Second == 0,
                    UpdateFrequency.FiveMinutes => now.Minute % 5 == 0 && now.Second == 0,
                    UpdateFrequency.ThirtyMinutes => now.Minute % 30 == 0 && now.Second == 0,
                    UpdateFrequency.OneHour => now.Minute == 0 && now.Second == 0,
                    _ => true
                };

                if (!shouldUpdate) return;

                if (Frequency == UpdateFrequency.ThirtySeconds && _lastCalculationTime.Minute == now.Minute && _lastCalculationTime.Second / 30 == now.Second / 30) return;
                if (Frequency == UpdateFrequency.OneMinute && _lastCalculationTime.Minute == now.Minute) return;
                if (Frequency == UpdateFrequency.FiveMinutes && _lastCalculationTime.Minute / 5 == now.Minute / 5 && _lastCalculationTime.Hour == now.Hour) return;
                if (Frequency == UpdateFrequency.ThirtyMinutes && _lastCalculationTime.Minute / 30 == now.Minute / 30 && _lastCalculationTime.Hour == now.Hour) return;
                if (Frequency == UpdateFrequency.OneHour && _lastCalculationTime.Hour == now.Hour) return;

                _lastCalculationTime = now;
            }

            var provider = OptionsDataProvider;
            if (provider == null)
            {
                _chipText = "NO OPTIONS DATA";
                return;
            }

            var candle = GetCandle(bar);
            if (candle == null) return;
            decimal spot = candle.Close;

            try
            {
                var type = provider.GetType().GetInterfaces().FirstOrDefault(i => i.Name.Contains("OptionsDataProvider")) ?? provider.GetType();
                var seriesMethod = type.GetMethod("GetOptionSeriesAsync");

                if (seriesMethod != null)
                {
                    var task = seriesMethod.Invoke(provider, new object[] { System.Threading.CancellationToken.None });
                    var rawResult = task?.GetType().GetProperty("Result")?.GetValue(task) as System.Collections.IEnumerable;

                    if (rawResult != null)
                    {
                        var seriesList = rawResult.Cast<dynamic>().ToList();

                        if (seriesList.Any())
                        {
                            var targetSeries = ZeroDteOnly
                                ? seriesList.FirstOrDefault(s => s.Expiration.Date == DateTime.Today) ?? seriesList.OrderBy(s => s.Expiration).FirstOrDefault()
                                : seriesList.OrderBy(s => s.Expiration).FirstOrDefault();

                            if (targetSeries != null)
                            {
                                DateTime expDate = targetSeries.Expiration;
                                int dte = (expDate.Date - DateTime.Today).Days;
                                if (dte < 0) dte = 0;
                                string dteString = $"{dte}DTE";

                                var optionsMethod = type.GetMethod("GetOptionsAsync");
                                var optionsTask = optionsMethod?.Invoke(provider, new object[] { targetSeries, System.Threading.CancellationToken.None });
                                var rawOptions = optionsTask?.GetType().GetProperty("Result")?.GetValue(optionsTask) as System.Collections.IEnumerable;

                                if (rawOptions != null)
                                {
                                    var contracts = rawOptions.Cast<dynamic>().ToList();

                                    var closestStrikes = contracts
                                        .OrderBy(x => Math.Abs((decimal)x.StrikePrice - spot))
                                        .Take(StrikesPerSide * 4)
                                        .Select(x => (decimal)x.StrikePrice)
                                        .ToHashSet();

                                    decimal totalCallGex = 0m;
                                    decimal totalPutGex = 0m;

                                    Dictionary<decimal, decimal> strikeCallGexMap = new();
                                    Dictionary<decimal, decimal> strikePutGexMap = new();
                                    Dictionary<decimal, decimal> strikeNetGexMap = new();
                                    Dictionary<decimal, decimal> strikeOiMap = new();

                                    var subMethod = type.GetMethod("SubscribeToOption");

                                    foreach (dynamic contract in contracts)
                                    {
                                        try
                                        {
                                            decimal strikePrice = (decimal)contract.StrikePrice;
                                            string optType = contract.OptionType.ToString();
                                            decimal oi = 0m;
                                            bool isClosest = closestStrikes.Contains(strikePrice);

                                            try { oi = (decimal)contract.OpenInterest; }
                                            catch { }

                                            if (oi <= 0 && isClosest)
                                            {
                                                var subInstance = subMethod?.Invoke(provider, new object[] { contract });
                                                if (subInstance != null)
                                                {
                                                    var summaryProp = subInstance.GetType().GetProperty("Summary");
                                                    var summaryObj = summaryProp?.GetValue(subInstance);
                                                    if (summaryObj != null)
                                                    {
                                                        try { oi = (decimal)summaryObj.GetType().GetProperty("OpenInterest")?.GetValue(summaryObj); }
                                                        catch { }
                                                    }
                                                }
                                            }

                                            if (oi <= 0) continue;

                                            strikeOiMap[strikePrice] = strikeOiMap.GetValueOrDefault(strikePrice, 0m) + oi;

                                            decimal estimatedGamma = 0.005m;
                                            decimal contractGex = estimatedGamma * oi * spot * 100m;

                                            if (optType.Contains("Call"))
                                            {
                                                totalCallGex += contractGex;
                                                if (isClosest) strikeCallGexMap[strikePrice] = strikeCallGexMap.GetValueOrDefault(strikePrice, 0m) + contractGex;
                                                strikeNetGexMap[strikePrice] = strikeNetGexMap.GetValueOrDefault(strikePrice, 0m) + contractGex;
                                            }
                                            else if (optType.Contains("Put"))
                                            {
                                                totalPutGex += contractGex;
                                                if (isClosest) strikePutGexMap[strikePrice] = strikePutGexMap.GetValueOrDefault(strikePrice, 0m) + contractGex;
                                                strikeNetGexMap[strikePrice] = strikeNetGexMap.GetValueOrDefault(strikePrice, 0m) - contractGex;
                                            }
                                        }
                                        catch { continue; }
                                    }

                                    // 1. Calculate Call Wall
                                    if (strikeCallGexMap.Any())
                                    {
                                        var bestCall = strikeCallGexMap.OrderByDescending(x => x.Value).First();
                                        _callWallPrice = bestCall.Key;
                                        decimal callOi = strikeOiMap.GetValueOrDefault(_callWallPrice, 0m);
                                        _callWallMetric = bestCall.Value > 1_000_000 ? $"{bestCall.Value / 1_000_000:F1}M GEX" : $"{callOi:N0} OI";
                                    }

                                    // 2. Calculate Put Wall
                                    if (strikePutGexMap.Any())
                                    {
                                        var bestPut = strikePutGexMap.OrderByDescending(x => x.Value).First();
                                        _putWallPrice = bestPut.Key;
                                        decimal putOi = strikeOiMap.GetValueOrDefault(_putWallPrice, 0m);
                                        _putWallMetric = bestPut.Value > 1_000_000 ? $"{bestPut.Value / 1_000_000:F1}M GEX" : $"{putOi:N0} OI";
                                    }

                                    // 3. Calculate True Zero-Gamma (Flip) Level 
                                    var activeStrikes = strikeNetGexMap.Where(x => strikeOiMap.GetValueOrDefault(x.Key, 0m) > 100).ToList();
                                    if (activeStrikes.Any())
                                    {
                                        // Take the active strikes nearest the spot price where both Calls and Puts exist
                                        var nearbyContestedStrikes = activeStrikes
                                            .OrderBy(x => Math.Abs(x.Key - spot))
                                            .Take(25)
                                            .Where(x => strikeCallGexMap.GetValueOrDefault(x.Key, 0m) > 0 && strikePutGexMap.GetValueOrDefault(x.Key, 0m) > 0)
                                            .ToList();

                                        decimal flipStrike = spot;

                                        if (nearbyContestedStrikes.Any())
                                        {
                                            decimal minAbsNetGex = decimal.MaxValue;
                                            foreach (var kvp in nearbyContestedStrikes)
                                            {
                                                // The flip is where net GEX is closest to true zero among highly contested strikes
                                                if (Math.Abs(kvp.Value) < minAbsNetGex)
                                                {
                                                    minAbsNetGex = Math.Abs(kvp.Value);
                                                    flipStrike = kvp.Key;
                                                }
                                            }
                                        }

                                        _flipLevelPrice = flipStrike;
                                        decimal flipOi = strikeOiMap.GetValueOrDefault(_flipLevelPrice, 0m);
                                        _flipMetric = flipOi > 0 ? $"{flipOi:N0} OI" : "FLIP";
                                    }

                                    _lastNetGex = totalCallGex - totalPutGex;
                                    _isPositiveGamma = _lastNetGex >= 0;

                                    string regimeLabel = _isPositiveGamma ? "+ GAMMA" : "- GAMMA";
                                    List<string> chipParts = new List<string> { regimeLabel };

                                    if (ShowGexValue)
                                    {
                                        decimal absGex = Math.Abs(_lastNetGex);
                                        string gexFormatted = absGex >= 1_000_000_000 ? $"{absGex / 1_000_000_000:F2}B" :
                                                              absGex >= 1_000_000 ? $"{absGex / 1_000_000:F1}M" :
                                                              absGex >= 1_000 ? $"{absGex / 1_000:F0}K" : $"{absGex:F0}";
                                        chipParts.Add(gexFormatted);
                                    }

                                    if (ShowExpiry)
                                    {
                                        chipParts.Add(dteString);
                                    }

                                    _chipText = string.Join("  |  ", chipParts);
                                    return;
                                }
                            }
                        }
                    }
                }
                _chipText = "WAITING FOR CHAIN...";
            }
            catch (Exception ex)
            {
                var realError = ex.InnerException != null ? ex.InnerException.Message : ex.Message;
                string shortErr = realError.Length > 35 ? realError.Substring(0, 35) : realError;
                _chipText = $"ERR: {shortErr}";
            }
        }

        protected override void OnRender(RenderContext context, DrawingLayouts layout)
        {
            if (ChartInfo == null || Container == null) return;

            int rightEdge = Container.Region.Width;

            int callTagOffset = 0;
            int putTagOffset = 0;
            int flipTagOffset = 0;

            if (ShowCallWall && ShowPutWall && _callWallPrice == _putWallPrice)
            {
                putTagOffset = 22;
            }

            if (ShowFlipLevel)
            {
                if (_flipLevelPrice == _callWallPrice && _flipLevelPrice == _putWallPrice)
                    flipTagOffset = 44;
                else if (_flipLevelPrice == _callWallPrice || _flipLevelPrice == _putWallPrice)
                    flipTagOffset = 22;
            }

            // 1. Render Key Levels
            if (ShowCallWall && _callWallPrice > 0)
                DrawMultiplexLevel(context, _callWallPrice, $"CALL WALL [{_callWallMetric}]", CallWallColor, CallWallZoneColor, CallWallTextColor, CallWallStyle, CallWallWidth, CallWallZoneThickness, rightEdge, callTagOffset);

            if (ShowPutWall && _putWallPrice > 0)
                DrawMultiplexLevel(context, _putWallPrice, $"PUT WALL [{_putWallMetric}]", PutWallColor, PutWallZoneColor, PutWallTextColor, PutWallStyle, PutWallWidth, PutWallZoneThickness, rightEdge, putTagOffset);

            if (ShowFlipLevel && _flipLevelPrice > 0)
                DrawMultiplexLevel(context, _flipLevelPrice, $"GAMMA FLIP [{_flipMetric}]", FlipColor, FlipZoneColor, FlipTextColor, FlipStyle, FlipWidth, FlipZoneThickness, rightEdge, flipTagOffset);

            // 2. Render Main HUD Chip
            var textSize = context.MeasureString(_chipText, _font);
            int chipWidth = (int)textSize.Width + (Padding * 2);
            int chipHeight = (int)textSize.Height + (Padding * 2);

            int x = HorizontalPosition == HorizontalAlignment.Left ? OffsetX : rightEdge - chipWidth - OffsetX;
            int y = VerticalPosition == VerticalAlignment.Top ? OffsetY : Container.Region.Height - chipHeight - OffsetY;

            Color bgColor = _isPositiveGamma ? PositiveColor : NegativeColor;
            Color translucentBg = Color.FromArgb(210, bgColor.R, bgColor.G, bgColor.B);

            context.FillRectangle(translucentBg, new Rectangle(x, y, chipWidth, chipHeight));
            context.DrawRectangle(new RenderPen(bgColor, 2f), new Rectangle(x, y, chipWidth, chipHeight));
            context.DrawString(_chipText, _font, TextColor, x + Padding, y + Padding);
        }

        private void DrawMultiplexLevel(RenderContext context, decimal price, string labelText, Color lineColor, Color zoneColor, Color textColor, DashStyle style, int lineWidth, int zoneThickness, int rightEdge, int tagYOffset)
        {
            int yPos = ChartInfo.GetYByPrice(price, false);
            if (yPos < 0 || yPos > Container.Region.Height) return;

            if (zoneThickness > 0)
            {
                int halfThick = zoneThickness / 2;
                context.FillRectangle(zoneColor, new Rectangle(0, yPos - halfThick, rightEdge, zoneThickness));
            }

            var pen = new RenderPen(lineColor, lineWidth) { DashStyle = style };
            context.DrawLine(pen, 0, yPos, rightEdge, yPos);

            var tagSize = context.MeasureString(labelText, _levelFont);
            int tagX = rightEdge - 20;

            if (LevelTextAlignment == LabelAlignment.Left)
                tagX = 15;
            else if (LevelTextAlignment == LabelAlignment.Center)
                tagX = (rightEdge - (int)tagSize.Width) / 2;
            else
                tagX = rightEdge - (int)tagSize.Width - 15;

            int tagY = yPos - (int)tagSize.Height / 2 + tagYOffset;

            context.FillRectangle(Color.FromArgb(220, 15, 20, 30), new Rectangle(tagX - 6, tagY - 3, (int)tagSize.Width + 12, (int)tagSize.Height + 6));
            context.DrawRectangle(new RenderPen(lineColor, 1f), new Rectangle(tagX - 6, tagY - 3, (int)tagSize.Width + 12, (int)tagSize.Height + 6));
            context.DrawString(labelText, _levelFont, textColor, tagX, tagY);
        }
